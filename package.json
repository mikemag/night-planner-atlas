{
  "name": "night-planner-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Plan dark-sky nights by month and year with twilight, astronomical darkness, moonlight and usable dark for any site.",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run check && npm run test:e2e && firebase deploy --only hosting --project night-planner-atlas",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test",
    "screenshots:retina": "SCREENSHOTS=1 playwright test --project=webkit-retina",
    "screenshots:readme": "npm run build && node scripts/capture-readme.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "astronomy-engine": "^2.1.19",
    "bootstrap": "5.3.8",
    "tzf-wasm": "2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bootstrap": "5.2.11",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
